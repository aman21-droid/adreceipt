{
  "name": "adreceipt-backend",
  "version": "0.1.0",
  "description": "AdReceipt Graph and Sepolia receipt verification service.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node src/server/index.ts",
    "start": "ts-node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node src/v2/store/migrate.ts",
    "test": "node --test -r ts-node/register src/receipts/*.test.ts src/domain/*.test.ts src/privy/*.test.ts src/server/*.test.ts src/v2/*.test.ts src/v2/**/*.test.ts",
    "verify:live": "ts-node src/scripts/verify-live.ts",
    "verify:live:dry": "ts-node src/scripts/verify-live.ts --dry-run",
    "cre:simulate": "ts-node cre/src/simulate.ts",
    "fund": "ts-node src/scripts/fund.ts",
    "fund:dry": "ts-node src/scripts/fund.ts --dry-run",
    "seed:wallets": "ts-node src/scripts/seed-wallets.ts",
    "seed:identity": "ts-node src/scripts/seed-identity.ts",
    "seed:spend": "ts-node src/scripts/seed-spend.ts"
  },
  "dependencies": {
    "@privy-io/node": "0.34.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
